#!/bin/sh
# Static freeze-contract gate: repo-portable subset of run_offline_checks.bat.
# Full suite (pin/networks/curriculum) still needs the IsaacLab venv — run
# rl_exp\tools\verify\run_offline_checks.bat before structural changes.
# Enable once per clone: git config core.hooksPath hooks
set -u

REPO=$(git rev-parse --show-toplevel) || exit 1
cd "$REPO" || exit 1

# Only gate commits that touch recipe-relevant files; docs-only commits pass.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
echo "$STAGED" | grep -qE '^(rl_exp|ablation_harness)/.*\.(py|yaml|yml|json|urdf|usda|usd)$' || exit 0

# Python: the venv is recorded in paths.yaml (or RL_PYTHON) and reported by
# host_paths.py -- a stdlib-only query, so whatever python is on PATH can ask
# it. The obs-layout gate below needs isaaclab, so it is skipped when the
# answer is missing and only the plain-python parity gate runs.
PY=""
if command -v python >/dev/null 2>&1; then
  PY=$(python ablation_harness/host_paths.py --python 2>/dev/null)
fi
HAVE_VENV=1
{ [ -n "$PY" ] && [ -f "$PY" ]; } || { PY=python; HAVE_VENV=0; }

echo "[pre-commit] check_dr_parity --strict"
"$PY" rl_exp/tools/verify/check_dr_parity.py --strict || {
  echo "[pre-commit] FAIL: freeze contracts (see above). Reviewed divergence -> ALLOWLIST in check_dr_parity.py; intentional asset retirement -> --update-locks in the same commit."
  exit 1
}

if [ "$HAVE_VENV" = 1 ]; then
  echo "[pre-commit] check_obs_layout"
  "$PY" rl_exp/tools/verify/check_obs_layout.py || {
    echo "[pre-commit] FAIL: obs layout gate (group names / term order / c_k consistency)."
    exit 1
  }
else
  echo "[pre-commit] WARN: IsaacLab venv not found, skipping check_obs_layout (parity gate above still ran)"
fi

echo "[pre-commit] static gates passed"
exit 0
