# Python cache
__pycache__/
*.pyc

# Local scratch and operating system files. Put reusable diagnostics under tools/diagnose/.
Thumbs.db
.DS_Store
.pytest_cache/
_tmp_*

# ponytail upstream clone (update source only, installed artifacts are committed)
/ponytail/

# machine-local host paths (isaac_root + venv python); paths.example.yaml is the
# committed template, read by evaluation/host_paths.py
/paths.yaml

# Training and diagnostic outputs stay machine-local. rl_exp/out/ holds the live
# training root, the in-flight item directories, and archive/pre-refactor/ -- the
# local archive of the tree retired by
# acceptance/records/2026-11-24-legacy-entrypoint-cleanup.md, with a
# manifest*.json recording each file's original path, sha256 and git blob. Nothing
# one-off belongs here: use %TEMP% and delete it afterwards.
rl_exp/out/

# video-matrix clips (evaluation/video_matrix.py): mp4 + matrix.json, same treatment as
# the diagnostic dumps above -- regenerable in one command from a checkpoint plus a gear list,
# and the durable evidence is the numbers written into the record, never the clip itself
evaluation/videos/

# model checkpoints and raw frame tensors (*.pt): a checkpoint's identity is its entry in the
# run's checkpoints.json (file sha256 + the run's T1 digest + the payload digest written into
# the file's own infos), and the frames are an intermediate the record path regenerates, so the
# file is not the record.
*.pt

# blender autosave backups
*.blend1
