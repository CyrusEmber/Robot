# Python cache
__pycache__/
*.pyc

# local junk
Thumbs.db
.DS_Store
_tmp_*

# ponytail upstream clone (update source only, installed artifacts are committed)
/ponytail/

# machine-local host paths (isaac_root + venv python); paths.example.yaml is the
# committed template, read by ablation_harness/host_paths.py
/paths.yaml

# derived viz -- rebuildable in seconds from committed data (tb_scalars.csv +
# eval.json + summary.csv) via plot_tb.py / plot_eval.py, so never a record
rl_exp/versions/**/plots/
**/report*.html

# full-fidelity per-iteration curves stay machine-local: ~20 MB per version (60 MB
# for the three trained so far) for 14-15k rows/tag at ~52 B/row, and every trend
# the version notes read off them survives sampling. The committed
# rl_exp/versions/**/tb_scalars.csv is the `dump_tb.py --max_points 150` record
# (~210 KB) and is regenerable from these without TensorBoard:
#   dump_tb.py --csv_in <vN/tb_scalars.full.csv> --out <vN/tb_scalars.csv> --max_points 150
rl_exp/versions/**/tb_scalars.full.csv

# diagnostic products: rl_exp/tools/diagnose/out/<label>/ holds per-case json +
# summary.md + run logs (layout documented in tools/diagnose/diagnose_support.py)
# and, for long runs, png/video. Products like the plots above -- the durable
# evidence is the numbers written into the record plus the command that
# regenerates them, never the dump itself.
rl_exp/tools/diagnose/out/

# video-matrix clips (ablation_harness/video_matrix.py): mp4 + matrix.json, same treatment as
# the diagnose dumps above -- regenerable in one command from a checkpoint plus a gear list,
# and the durable evidence is the numbers written into the record, never the clip itself
ablation_harness/videos/

# blender autosave backups
*.blend1

# asset pipeline intermediates: generate_urdf output dir (transient; the
# working copies land in rl_exp/meshes + versions/lizard/lizard.urdf) and the
# converter-input mesh copy next to the URDF (importer 3.0 resolves mesh paths
# relative to the URDF's own directory; regenerable from rl_exp/meshes)
rl_exp/lizard_urdf/
rl_exp/versions/lizard/meshes/
