          "expect": {"verdict": "fail", "gates": {"no_non_foot_carrier": false}}
        },
        "carrier_alternating_bodies_short_of_the_dwell_pass": {
          "fixture": "carrier_alternating",
          "kw": {"span_s": 0.48},
          "expect": {"verdict": "pass", "gates": {"no_non_foot_carrier": true}}
        },
        "mesh_exactly_at_the_declared_floor_fails": {
          "fixture": "mesh_at_threshold",
          "kw": {},
          "expect": {"verdict": "fail", "gates": {"no_mesh_through_floor": false}}
        }
      }
    },
    "loco-metrics-1+loco-derivation-1": {
