{
  "format": "judge-semantics-1",
  "why": [
    "A judge id is only an identity if some case set is pinned to it. Freezing one sample would not do: a sample only covers the behaviour it happens to touch, so an edit outside that path would leave the id unchanged while the semantics moved.",
    "So each id carries its own case list and its expectations. A published id's block is frozen by digest: editing its cases, its expectations or the kind table it can reach turns rl_exp/tools/verify/check_judge_semantics.py red. A new behaviour therefore needs a new kind and a new id -- `baseline_metrics.JUDGE_ID` or a new entry in LEGACY_PROTOCOLS -- instead of an edit that would leave old records pointing at a reader that no longer exists.",
    "The gap this does not close, stated rather a case set only covers the cases written down. Behaviour inside a kind that no case exercises can still move without turning anything red. That is why the blocks below keep the boundary cases (equality at the threshold, the dwell length, the aggregation order across bodies) -- the places where an off-by-one is invisible in a passing rollout."
  ],
  "ids": {
    "baseline-criteria-1": {
      "module": "ablation_harness.baseline_metrics",
      "constant": "JUDGE_ID",
      "driver": "baseline",
      "protocol_file": "baseline_flat_v4.json",
      "kinds": [
        "displacement_v1",
        "mesh_clearance_v1",
        "non_foot_carrier_v1",
        "non_foot_contact_v1",
        "survival_v1",
        "sustained_tilt_v1",
        "tracking_v1"
      ],
      "kinds_sha256": "sha256:84a31481056029775cc5f4708aef021cceec038c85d80c453a7e68b03e415908",
      "frozen_sha256": "sha256:b06524f46df275652e2d79945ec8b32a4e050925221d4c19af6f4575e277e48f",
      "cases": {
        "straight_walk_passes_every_declared_gate": {
          "fixture": "plain",
          "kw": {},
          "expect": {
            "verdict": "pass",
            "gates": {
              "tracking": true,
              "displacement": true,
              "survival": true,
              "attitude": true,
              "no_non_foot_contact": true
            }
          }
        },
        "tilt_held_exactly_the_dwell_fails": {
          "fixture": "tilt_hold",
          "kw": {"seconds": 0.5},
          "expect": {"verdict": "fail", "gates": {"attitude": false}}
        },
        "tilt_one_frame_short_of_the_dwell_passes": {
          "fixture": "tilt_hold",
          "kw": {"seconds": 0.48},
          "expect": {"verdict": "pass", "gates": {"attitude": true}}
        },
        "contact_exactly_at_the_limit_is_not_contact": {
          "fixture": "contact",
          "kw": {"fraction": "at_limit"},
          "expect": {"verdict": "pass", "gates": {"no_non_foot_contact": true}}
        },
        "contact_above_the_limit_on_one_frame_fails": {
          "fixture": "contact",
          "kw": {"fraction": "just_above_limit"},
          "expect": {"verdict": "fail", "gates": {"no_non_foot_contact": false}}
        },
        "tracking_error_and_distance_exactly_at_their_thresholds_fail": {
          "fixture": "tracking_at_threshold",
          "kw": {},
          "expect": {"verdict": "fail", "gates": {"tracking": false, "displacement": false}}
        }
      }
    },
    "legacy-baseline-threshold-keys-1": {
      "module": "ablation_harness.baseline_metrics",
      "constant": "LEGACY_JUDGE_ID",
      "driver": "baseline",
      "protocol_file": "baseline_flat_v2.json",
      "kinds": [
        "displacement_v1",
        "mesh_clearance_v1",
        "non_foot_carrier_v1",
        "non_foot_contact_v1",
        "survival_v1",
        "sustained_tilt_v1",
        "tracking_v1"
      ],
      "kinds_sha256": "sha256:84a31481056029775cc5f4708aef021cceec038c85d80c453a7e68b03e415908",
      "frozen_sha256": "sha256:0a6d1919d07d0fbb510dec3befcc871c8564e6b9769bf193a19a5fe869201fc6",
      "cases": {
        "carrier_fraction_exactly_at_the_threshold_fails": {
