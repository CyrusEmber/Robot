+def _or_die(call, *args, **kwargs):
+    """Call ``call``, or print the traceback and leave with a code the caller can read.
+
+    The sim app is up by now, so an exception that unwinds out of the ``launch_simulation`` body
+    reaches that context manager's ``finally: close_fn()``, and the teardown exits the process
+    itself: measured 2026-09-18, a failure inside ``gym.make`` left exit code 0 with no
+    python-level exit hook (``os._exit``, ``sys.exit``, ``atexit``) ever running, so the
+    ``__main__`` handler below never saw it. Leaving from the failure site is the only place the
+    code survives.
+    """
+    try:
+        return call(*args, **kwargs)
+    except Exception:
+        import traceback
+
+        traceback.print_exc()
+        os._exit(1)
+
